# =============================================================================
#  Plantilla de configuración — Departamentos Dimo
# =============================================================================
#  Este archivo SÍ se sube al repo: es la plantilla, no tiene claves reales.
#  Para usarlo:
#
#      cp .env.example .env        (PowerShell:  copy .env.example .env)
#
#  Después pegá tus valores en el .env y corré:
#
#      npm run config
#
#  Eso genera supabase-config.js, que es lo que carga el navegador.
#  Paso a paso completo en SUPABASE.md, sección 3.
# =============================================================================


# -----------------------------------------------------------------------------
#  SUPABASE
#  Dónde se sacan: panel de Supabase -> Project Settings -> API
# -----------------------------------------------------------------------------

# "Project URL". Solo el origen: sin barra al final y sin /rest/v1.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# La clave PÚBLICA. Según la edad del proyecto vas a ver una de estas dos:
#   - "Publishable key"  -> empieza con  sb_publishable_...   (formato nuevo)
#   - "anon public"      -> un JWT largo que empieza con  eyJ...  (legacy)
# Cualquiera de las dos sirve. Es pública por diseño: queda visible en el código
# del sitio y está bien, porque la seguridad la dan las políticas RLS.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
#  NUNCA pongas acá la clave secreta
# -----------------------------------------------------------------------------
#  La "service_role" (JWT) o la "sb_secret_..." saltean TODAS las políticas RLS:
#  con esa clave cualquiera puede leer, editar y borrar toda la base desde la
#  consola del navegador. Solo va en un servidor (Edge Function), nunca en el
#  front. `npm run config` aborta si detecta una clave secreta en
#  SUPABASE_ANON_KEY, pero la regla la tenés que tener vos.
