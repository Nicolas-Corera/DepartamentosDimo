# ===========================================================================
# Panel de administración — variables de entorno
#
# Este es un proyecto de Vercel APARTE del sitio y del checkout: estas
# variables se cargan en Vercel → proyecto del dashboard → Settings →
# Environment Variables. No las hereda de los otros proyectos.
#
# Copiá este archivo como `.env` para desarrollo local. El `.env` está en el
# .gitignore y no se sube.
# ===========================================================================

# --- Acceso -----------------------------------------------------------------
# El código de 6 dígitos que se tipea en /login_panel.
#
# Es lo ÚNICO que separa a cualquiera de los datos personales de tus huéspedes
# y del botón que devuelve plata. Que no sea uno que uses en otro lado, y no lo
# mandes por WhatsApp.
PANEL_CODIGO=123456

# Con qué se firma la cookie de sesión. Larga y al azar; si se puede adivinar,
# se puede fabricar una sesión válida sin saber el código.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_SESION_SECRET=

# --- Supabase ---------------------------------------------------------------
# Las mismas que usa el checkout.
SUPABASE_URL=
# La service_role, no la anon: el panel lee y escribe tablas con RLS cerrado.
SUPABASE_SERVICE_ROLE_KEY=

# --- MercadoPago ------------------------------------------------------------
# El mismo Access Token del checkout. Se usa SOLO para las devoluciones desde
# la pestaña Alquileres. Si no está, el panel funciona igual: lo único que no
# se puede hacer es devolver plata.
MP_ACCESS_TOKEN=

# --- Mails (Resend) ---------------------------------------------------------
# El panel manda un solo tipo de mail: el comprobante de pagos@ cuando aprobás
# una transferencia. Ahí la transferencia recién pasa a contar como pago, así
# que ese es el momento de avisar.
#
# Si falta, aprobar sigue funcionando: lo único que no pasa es el envío.
RESEND_API_KEY=

# A quién le llega la copia con el comprobante adjunto. Separadas por coma.
DUENOS_EMAILS=

# --- URLs -------------------------------------------------------------------
SITIO_URL=https://departamentosdimo.com.ar
PAGO_URL=https://pago.departamentosdimo.com.ar
PANEL_URL=https://dash.departamentosdimo.com.ar

# --- Contacto que se le muestra al huésped ----------------------------------
# Van en el pie de todos los mails que recibe el inquilino y en las pantallas
# del checkout. A los dueños, en cambio, se les muestran el mail y el teléfono
# del huésped, con el número enlazado a WhatsApp.
#
# La casilla contacto@ hay que crearla en el proveedor de mail: Resend solo
# envía, no recibe. Si no existe, los mensajes que manden ahí rebotan.
MAIL_DE_CONTACTO=contacto@departamentosdimo.com.ar

# Número de WhatsApp, solo dígitos y con código de país, sin + ni espacios.
WHATSAPP_CONTACTO=5491159367822
