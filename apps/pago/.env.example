# ===========================================================================
# Variables del sitio de pago  —  COPIÁ ESTE ARCHIVO COMO .env Y COMPLETALO
#
#   cp .env.example .env
#
# El .env está en el .gitignore: nunca se commitea. Estas mismas variables hay
# que cargarlas en Vercel (Settings -> Environment Variables) del proyecto que
# tiene Root Directory = pago.
#
# Ambientes: usá las credenciales de PRUEBA en Development y Preview, y las de
# PRODUCCIÓN solo en Production. Ver MERCADOPAGO.md, sección 2.
# ===========================================================================

# --- MercadoPago ------------------------------------------------------------
# Panel: https://www.mercadopago.com.ar/developers/panel/app -> tu aplicación
#        -> Credenciales de prueba / Credenciales de producción
#
# La Public Key es pública (se la sirve la API al navegador para montar el
# Brick). El Access Token es SECRETO: solo lo usa el backend.
#
# Las de prueba empiezan con TEST-, las de producción con APP_USR-.
# Las dos tienen que ser del MISMO ambiente: si mezclás, MercadoPago rechaza
# el token de tarjeta. El backend valida esto al arrancar.
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Clave secreta del webhook. Se genera en el panel de MercadoPago:
# tu aplicación -> Webhooks -> Configurar notificaciones -> "Generar clave secreta".
# Sin esto el webhook rechaza TODAS las notificaciones (que es lo que queremos:
# preferimos no procesar nada antes que procesar algo sin firmar).
MP_WEBHOOK_SECRET=

# Lo que ve el titular en el resumen de la tarjeta. Máximo 13 caracteres,
# sin acentos ni símbolos raros.
MP_STATEMENT_DESCRIPTOR=DIMO

# --- Supabase ---------------------------------------------------------------
# Misma URL que usa el sitio principal.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️  CLAVE SECRETA — saltea RLS. Solo backend. NUNCA en el navegador.
# Supabase -> Project Settings -> API -> service_role / sb_secret_...
# Se usa para leer booking_requests (que es solo-alta para el sitio) y para
# escribir en la tabla payments.
SUPABASE_SERVICE_ROLE_KEY=

# --- Precios ----------------------------------------------------------------
# Los precios YA NO ESTÁN ACÁ.
#
# Viven en las tablas `temporadas`, `medios_pago`, `planes_cuotas` y
# `tarifas_especiales` de Supabase, y se editan desde el dashboard
# (dash.departamentosdimo.com.ar). Cambiar un precio no puede depender de
# editar una variable en Vercel y esperar un redeploy.
#
# El monto sigue sin viajar nunca desde el navegador: el backend lo recalcula
# noche por noche con las fechas de la reserva y la configuración de la base.
#
# Para crear esas tablas: correr pago/sql/configuracion-tarifas.sql en Supabase.

# --- Comportamiento ---------------------------------------------------------
# Si un pago se aprueba, ¿marcamos la reserva como "confirmada" en
# booking_requests? Poné false si preferís confirmarlas a mano desde el panel.
CONFIRMAR_RESERVA_AL_APROBAR=true

# --- Mails (Resend) ---------------------------------------------------------
# API key de Resend: https://resend.com/api-keys
# Alcanza con una de solo-envío ("Sending access"). Es SECRETA.
#
# Si esta variable falta, los pagos siguen funcionando igual: lo único que no
# pasa es el envío de mails, y queda anotado en los logs.
RESEND_API_KEY=

# A quién le llegan los avisos de dueño (seña cobrada, pago recibido,
# comprobante para revisar). Son cuentas de Gmail comunes: Resend les manda
# el mail y les entra en la bandeja como cualquier otro.
#
# Separadas por coma si son varias:
#   DUENOS_EMAILS=diego@gmail.com,nicolas@gmail.com
DUENOS_EMAILS=

# El % de seña NO se configura acá: vive en la tabla `configuracion_pagos` de
# Supabase y se edita desde el panel (pestaña Tarifas).

# --- URLs -------------------------------------------------------------------
# Se usan para armar los links de pago que van en los mails.
SITIO_URL=https://departamentosdimo.com.ar
PAGO_URL=https://pago.departamentosdimo.com.ar
PANEL_URL=https://dash.departamentosdimo.com.ar

# --- Contacto que se le muestra al huésped ----------------------------------
# Van en el pie de todos los mails que recibe el inquilino y en las pantallas
# del checkout. A los dueños, en cambio, se les muestran el mail y el teléfono
# del huésped, con el número enlazado a WhatsApp.
#
# La casilla contacto@ hay que crearla en el proveedor de mail: Resend solo
# envía, no recibe. Si no existe, los mensajes que manden ahí rebotan.
MAIL_DE_CONTACTO=contacto@departamentosdimo.com.ar

# Número de WhatsApp, solo dígitos y con código de país, sin + ni espacios.
WHATSAPP_CONTACTO=5491159367822
