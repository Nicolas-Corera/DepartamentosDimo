# ===========================================================================
# Variables del sitio público  —  COPIÁ ESTE ARCHIVO COMO .env Y COMPLETALO
#
#   cp .env.example .env
#
# Estas mismas variables hay que cargarlas en Vercel (Settings → Environment
# Variables) del proyecto que tiene Root Directory = apps/sitio.
#
# Ojo con la diferencia entre las dos claves de Supabase:
#   SUPABASE_ANON_KEY          es pública, viaja al navegador (supabase-config.js)
#   SUPABASE_SERVICE_ROLE_KEY  es secreta, solo la usa /api/consulta
# ===========================================================================

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_...) o anon public (eyJ...). Es la que se
# hornea en supabase-config.js con `npm run config`: reseñas y calendario.
SUPABASE_ANON_KEY=

# ⚠️  CLAVE SECRETA — saltea RLS. Solo backend, NUNCA en el navegador.
# La usa /api/consulta para dar de alta la consulta y leer el id de la fila
# recién creada (booking_requests no tiene política de select).
SUPABASE_SERVICE_ROLE_KEY=

# --- Mails (Resend) ---------------------------------------------------------
# Si falta, la consulta se guarda igual: lo único que no pasa es el envío.
RESEND_API_KEY=

# A quién le llegan los avisos: consulta nueva (con los links de cobro) y
# reseña nueva pendiente de aprobar.
# Son cuentas de Gmail comunes. Separadas por coma si son varias:
#   DUENOS_EMAILS=diego@gmail.com,nicolas@gmail.com
DUENOS_EMAILS=

# --- URLs -------------------------------------------------------------------
# Con PAGO_URL se arman los links de "seña" y "total" del mail al dueño.
SITIO_URL=https://departamentosdimo.com.ar
PAGO_URL=https://pago.departamentosdimo.com.ar
PANEL_URL=https://dash.departamentosdimo.com.ar

# --- Contacto que se le muestra al huésped ----------------------------------
# Van en el pie de todos los mails que recibe el inquilino y en las pantallas
# del checkout. A los dueños, en cambio, se les muestran el mail y el teléfono
# del huésped, con el número enlazado a WhatsApp.
#
# La casilla contacto@ hay que crearla en el proveedor de mail: Resend solo
# envía, no recibe. Si no existe, los mensajes que manden ahí rebotan.
MAIL_DE_CONTACTO=contacto@departamentosdimo.com.ar

# Número de WhatsApp, solo dígitos y con código de país, sin + ni espacios.
WHATSAPP_CONTACTO=5491159367822
