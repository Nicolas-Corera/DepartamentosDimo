{
  "name": "departamentos-dimo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de Departamentos Dimo: el sitio, el checkout y el panel",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/sitio run dev",
    "dev:pago": "npm --prefix apps/pago run dev",
    "dev:dashboard": "npm --prefix apps/dashboard run dev",
    "config": "npm --prefix apps/sitio run config",
    "config:check": "npm --prefix apps/sitio run config:check"
  },
  "engines": {
    "node": ">=18"
  }
}
