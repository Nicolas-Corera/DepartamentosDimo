# ===========================================================================
# Variables de los bots de testing — COPIÁ ESTE ARCHIVO COMO .env
#
#   copy .env.example .env
#
# El .env está en el .gitignore de la raíz (patrón `.env`), no se commitea.
# Todo lo que hay acá es opcional: si no ponés nada, los bots usan los
# valores de config.json y corren contra localhost en modo de solo lectura.
# ===========================================================================

# --- Entorno ----------------------------------------------------------------
# "local" (dev servers en tu máquina) o "produccion".
#
# Solo el bot 2 (monitoreo) acepta "produccion", y aun así solo hace GET.
# Los bots 3 (carga), 4 (vulnerabilidades), 5 (fuzzing) y 6 (rate limiting)
# abortan con exit 1 si la URL no es localhost. Es a propósito.
ENTORNO=local

# --- URLs -------------------------------------------------------------------
# Pisan lo que dice config.json para el entorno elegido. Dejalas vacías salvo
# que corras los dev servers en otros puertos.
URL_SITIO=
URL_PAGO=
URL_PANEL=

# --- Escrituras reales ------------------------------------------------------
# ⚠️  LEÉ ESTO ANTES DE TOCARLO.
#
# Los dev servers locales leen el .env de cada app, que apunta a la Supabase y
# al Resend de PRODUCCIÓN. O sea: una consulta que se inserta desde localhost
# es una fila real en booking_requests y un mail real a DUENOS_EMAILS.
#
# Por eso los bots arrancan en modo seco: mandan payloads que la API rechaza
# antes de tocar la base, y en el navegador se frenan justo antes del submit.
#
# Poné 1 solo cuando quieras probar el camino completo de verdad, y después
# limpiá las filas de prueba (ver README, sección "Limpiar los datos de prueba").
PERMITIR_ESCRITURA=0

# --- Panel ------------------------------------------------------------------
# Código de 6 dígitos del panel. Si lo dejás vacío, los bots lo leen solos de
# apps/dashboard/.env para no tener el mismo secreto escrito en dos lados.
PANEL_CODIGO=

# --- Checkout ---------------------------------------------------------------
# UUID de una reserva existente en booking_requests, para que el bot funcional
# pueda abrir el checkout (pago/?ref=<uuid>&modo=reserva).
#
# Si está vacío, el bot saltea los pasos del checkout y avisa por qué.
# Para sacarlo: panel → Alquileres, o directo de la tabla en Supabase.
REF_DE_PRUEBA=

# --- Carga (pisan config.json) ----------------------------------------------
CARGA_USUARIOS=
CARGA_DURACION=
CARGA_RAMP_UP=
