{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-config.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pago",
      "destination": "https://pago.departamentosdimo.com.ar",
      "permanent": false
    },
    {
      "source": "/pago/:ruta*",
      "destination": "https://pago.departamentosdimo.com.ar/:ruta*",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "https://dash.departamentosdimo.com.ar",
      "permanent": false
    },
    {
      "source": "/dashboard/:ruta*",
      "destination": "https://dash.departamentosdimo.com.ar/:ruta*",
      "permanent": false
    }
  ]
}
